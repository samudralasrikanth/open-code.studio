{
  "name": "open-code.studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-Code.Studio monorepo foundation.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm arch:check && pnpm docs:check && pnpm build",
    "arch:check": "node scripts/validate-architecture.mjs",
    "docs:check": "node scripts/validate-docs.mjs",
    "dev:studio": "pnpm --filter @ocs/app-studio dev",
    "graph": "turbo run build --graph",
    "deps:check": "node scripts/check-dependencies.mjs",
    "health": "node scripts/health-check.mjs",
    "release:notes": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-import-x": "^4.6.1",
    "husky": "^9.1.7",
    "playwright": "^1.61.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
