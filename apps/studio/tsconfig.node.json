{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "../../packages/common/**/*",
    "../../packages/workspace/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "dist/main",
    "baseUrl": ".",
    "rootDir": "../..",
    "paths": {
      "@ocs/common": ["../../packages/common/src/index.ts"],
      "@ocs/common/*": ["../../packages/common/*/src/index.ts"],
      "@ocs/workspace": ["../../packages/workspace/src/index.ts"],
      "@ocs/workspace/*": ["../../packages/workspace/*/src/index.ts"]
    }
  },
  "exclude": ["../../packages/**/tests/**/*"]
}
