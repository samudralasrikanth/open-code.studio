{
  "name": "@ocs/app-studio",
  "productName": "Open-Code.Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Open-Code.Studio desktop application shell.",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "clean": "rm -rf dist .vite coverage",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@ocs/commands": "workspace:*",
    "@ocs/common": "workspace:*",
    "@ocs/document": "workspace:*",
    "@ocs/editor": "workspace:*",
    "@ocs/editor-monaco": "workspace:*",
    "@ocs/explorer": "workspace:^",
    "@ocs/extensions": "workspace:*",
    "@ocs/git": "workspace:*",
    "@ocs/keybindings": "workspace:*",
    "@ocs/notifications": "workspace:*",
    "@ocs/search": "workspace:*",
    "@ocs/session": "workspace:*",
    "@ocs/settings": "workspace:^",
    "@ocs/terminal": "workspace:*",
    "@ocs/theme": "workspace:*",
    "@ocs/ui": "workspace:*",
    "@ocs/workspace": "workspace:^",
    "@parcel/watcher": "^2.4.1",
    "@tanstack/react-virtual": "^3.14.5",
    "@vscode/ripgrep": "^1.15.9",
    "@xterm/addon-fit": "^0.10.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.24.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^2.1.8"
  }
}
